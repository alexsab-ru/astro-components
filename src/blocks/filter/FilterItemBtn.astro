---
interface Props {
	name: string;
	value?: string;
	id?: string;
	filterType: string;
}
const { name, value, id, filterType, ...rest } = Astro.props;
const inputValue = value || name;
// HTML id cannot contain spaces or commas. PageSpeed/axe treat
// ids like "atlas, ii" as unlabeled even when a wrapping <label> exists.
const inputId = `${filterType}-${id || inputValue}`
	.trim()
	.toLowerCase()
	.replace(/[^a-z0-9_-]+/g, '-')
	.replace(/^-+|-+$/g, '');
---

<!--
	Visible name lives inside <label>, not in a sibling.
	An empty wrapping label does not give the checkbox an accessible name.
-->
<div
	class="relative"
	{...rest}
>
	<label
		class="block cursor-pointer"
		for={inputId}
	>
		<input
			type="checkbox"
			value={inputValue}
			id={inputId}
			class="peer sr-only"
			@change={`toggleFilter('${filterType}', '${inputValue}', event)`}
		/>
		<div class="text-xs sm:text-base py-2 px-2 sm:px-4 no-underline rounded-md m-0 bg-gray-200 peer-checked:bg-accent-500 peer-checked:text-white">
			{name}
		</div>
	</label>
</div>
