---
import Component from '@/blocks/feature-cards/ImageFeatureCards.astro';
import { withLegacyServiceAction } from '../services-alt/legacyAction';
const items = (Astro.props.items || []).map(item => withLegacyServiceAction(item, true));
---
<Component {...Astro.props} items={items} id={Astro.props.id ?? 'specials'} />
