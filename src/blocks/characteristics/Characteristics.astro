---
export interface Characteristic {
	title: string;
	value: string | number;
	measure?: string;
}
interface Props {
	items?: Characteristic[];
	class?: string;
}
const { items = [], class: classes = 'container' } = Astro.props;
---

{items.length > 0 && (
	<div
		class={classes}
		data-characteristics
	>
		<div class="flex justify-center flex-wrap gap-4 mt-10 lg:mt-14 text-black">
			{items.map((item) => (
				<div class="flex flex-col justify-between gap-4 sm:gap-8 xs:p-3 p-4 shadow-sm rounded w-[calc((100%/2)-8px)] sm:w-[calc((100%/3)-11px)] xl:w-[calc((100%/6)-14px)]">
					<div class="text-xs sm:text-base">{item.title}:</div>
					<div>
						<b class="xs:text-xl text-2xl sm:text-3xl 2xl:text-4xl font-weight-bold">
							{item.value}
						</b>{' '}
						<span class="xs:text-[11px]">{item.measure}</span>
					</div>
				</div>
			))}
		</div>
	</div>
)}
