---
interface Props {
	mapImg: string;
	salons?: any[];
	classes?: string;
	clusterMarkers?: boolean;
	interactiveDirectory?: boolean;
	[key: string]: any;
}
const {salons = [], mapImg, classes = '', clusterMarkers = false, interactiveDirectory = false, ...rest} = Astro.props;
---

<div style={mapImg ? `background-image: url(${mapImg})` : undefined} class={`map ${classes}`} data-dealer-map data-cluster-markers={clusterMarkers ? '' : undefined} data-interactive-directory={interactiveDirectory ? '' : undefined} {...rest}>
	<div class="loader loader-default"></div>
	<div class="map-canvas"></div>
	<script type="application/json" data-map-salons set:html={JSON.stringify(salons).replace(/</g, '\\u003c')} />
</div>

<script>
import { phoneFormat } from '@/js/utils/numbers.format';
import { loadMapScript, observeMap, showMapError, withTimeout } from '@/js/utils/lazyMap';

const mapScriptUrl = 'https://api-maps.yandex.ru/2.1/?lang=ru_RU&loadByRequire=1';
const defaultZoom = 15;

document.querySelectorAll('[data-dealer-map]').forEach((container) => {
	const target = container.querySelector('.map-canvas');
	const loader = container.querySelector('.loader');
	const data = container.querySelector('[data-map-salons]')?.textContent;
	if (!target || !loader || !data) return;

	const locations = JSON.parse(data)
		.filter(salon => salon.map?.coordinates?.length === 2)
		.map(salon => ({ salon, position: salon.map.marker_coordinates ?? salon.map.coordinates }))
		.sort((a, b) => b.position[1] - a.position[1]);
	if (!locations.length) return;

	const [firstLatitude, firstLongitude] = locations[0].position;
	const hasMultipleLocations = locations.some(({ position: [latitude, longitude] }) =>
		latitude !== firstLatitude || longitude !== firstLongitude
	);
	const zoom = hasMultipleLocations ? 6 : (locations[0].salon.map.zoom ?? defaultZoom);
	const center = locations.reduce(([lat, lon], { position }) =>
		[lat + position[0], lon + position[1]], [0, 0]
	).map(total => total / locations.length);

	let map = null;
	let loading = false;
	let loadGeneration = 0;
	const directory = container.hasAttribute('data-interactive-directory');
	let state = { visible: locations.map(({ salon }) => salon.directoryId), selected: null };
	let renderDirectory;

	container.addEventListener('dealer-directory:update', event => {
		const next = event.detail;
		const changed = state.selected !== next.selected || state.visible.join(',') !== next.visible.join(',');
		state = next;
		if (!target.clientWidth) return;
		if (!map) {
			load();
			return;
		}
		requestAnimationFrame(() => {
			map?.container.fitToViewport();
			if (changed || next.fit) renderDirectory?.();
		});
	});

	function init() {
		map = new ymaps.Map(target, { center, zoom, controls: ['zoomControl'] });
		map.behaviors.disable('scrollZoom');

		const markers = locations.map(({ salon, position }) => {
			const { coordinates, balloon, ya_link, zoom: markerZoom } = salon.map;
			const route = ya_link || generateYandexMapLink(coordinates, markerZoom ?? defaultZoom);
			const marker = new ymaps.Placemark(position, {
				balloonContentHeader: `<h6 class="text-sm"><b>${salon.name}</b></h6>`,
				balloonContentBody: balloonContentBody(salon.schedule, salon.phone, route),
				hintContent: salon.address,
			}, {
				iconLayout: 'default#image',
				iconImageHref: balloon || 'https://img.upspace.ru/locator/empty-locator.svg',
				iconImageSize: [43, 62],
				iconImageOffset: [-21, -58],
				...(directory ? { openBalloonOnClick: false } : {}),
			});
			if (directory) {
				marker.events.add('click', () => container.dispatchEvent(new CustomEvent('dealer-directory:select', {
					bubbles: true,
					detail: salon.directoryId,
				})));
			}
			return marker;
		});

		if (directory) {
			const clusterer = new ymaps.Clusterer({ preset: 'islands#blueClusterIcons', zoomMargin: 48 });
			renderDirectory = () => {
				const visible = new Set(state.visible);
				const matching = locations.flatMap(({ salon }, index) =>
					visible.has(salon.directoryId) && salon.directoryId !== state.selected ? [markers[index]] : []
				);
				const selectedIndex = locations.findIndex(({ salon }) => salon.directoryId === state.selected);
				map.geoObjects.removeAll();
				clusterer.removeAll();
				if (matching.length > 1) {
					clusterer.add(matching);
					map.geoObjects.add(clusterer);
				} else if (matching.length) {
					map.geoObjects.add(matching[0]);
				}
				if (selectedIndex !== -1) {
					const { salon, position } = locations[selectedIndex];
					map.geoObjects.add(markers[selectedIndex]);
					map.setCenter(position, salon.map.zoom ?? defaultZoom);
				} else if (matching.length === 1) {
					map.setCenter(matching[0].geometry.getCoordinates(), defaultZoom);
				} else if (map.geoObjects.getBounds()) {
					map.setBounds(map.geoObjects.getBounds(), { checkZoomRange: true, zoomMargin: 48 });
				}
			};
			renderDirectory();
		} else if (markers.length > 1 && container.hasAttribute('data-cluster-markers')) {
			const clusterer = new ymaps.Clusterer({ preset: 'islands#blueClusterIcons', zoomMargin: 48 });
			clusterer.add(markers);
			map.geoObjects.add(clusterer);
		} else {
			markers.forEach(marker => map.geoObjects.add(marker));
		}

		if (!directory && hasMultipleLocations) {
			map.setBounds(map.geoObjects.getBounds(), { checkZoomRange: true, zoomMargin: 35 });
		}

		return waitForTilesLoad(map.layers.get(0).get(0));
	}

	async function load() {
		if (loading || map) return;
		loading = true;
		const generation = ++loadGeneration;
		target.replaceChildren();
		loader.classList.add('is-active');
		try {
			await withTimeout((async () => {
				if (!window.ymaps) await loadMapScript(mapScriptUrl);
				if (generation !== loadGeneration) return;
				await new Promise(resolve => ymaps.ready(resolve));
				if (generation !== loadGeneration) return;
				await init();
			})());
			container.removeEventListener('mouseenter', load);
			container.removeEventListener('click', load);
		} catch {
			loadGeneration += 1;
			map?.destroy();
			map = null;
			renderDirectory = undefined;
			showMapError(target, load);
		} finally {
			loading = false;
			loader.classList.remove('is-active');
		}
	}

	container.addEventListener('mouseenter', load);
	container.addEventListener('click', load);
	observeMap(container, load);
});

function balloonContentBody(hours, phone, route) {
	return `
	${hours ? `<p>${hours}</p>` : ''}
	${phone ? `<a href="tel:${phoneFormat(phone)}" class="inline-block text-lg text-accent-500 my-1">${phone}</a><br>` : ''}
	<a href="${route}" target="_blank" class="text-sm">📍 Проложить маршрут</a><br>
	`;
}

function waitForTilesLoad(layer) {
	return new ymaps.vow.Promise(resolve => {
		const tileContainer = getTileContainer(layer);
		if (!tileContainer) {
			resolve();
			return;
		}

		let ready = true;
		tileContainer.tiles.each(tile => {
			if (!tile.isReady()) ready = false;
		});
		if (ready) {
			resolve();
		} else {
			tileContainer.events.once('ready', resolve);
		}
	});
}

function getTileContainer(layer) {
	for (const value of Object.values(layer)) {
		if (
			value instanceof ymaps.layer.tileContainer.CanvasContainer ||
			value instanceof ymaps.layer.tileContainer.DomContainer
		) {
			return value;
		}
	}
}

function generateYandexMapLink(coordinates: [number, number], zoom: number): string {
	const [latitude, longitude] = coordinates;

	// Проверяем валидность координат
	if (latitude < -90 || latitude > 90 || longitude < -180 || longitude > 180) {
			throw new Error('Некорректные координаты');
	}

	// Проверяем валидность зума
	if (zoom < 1 || zoom > 19) {
			throw new Error('Некорректный уровень зума (должен быть от 1 до 19)');
	}
	
	// Формируем ссылку на Яндекс Карты
	const baseUrl = 'https://yandex.ru/maps/';
	const params = new URLSearchParams({
		ll: `${longitude},${latitude}`,
		z: zoom.toString(),
		l: 'map', // тип карты (map, sat, skl)
		pt: `${longitude},${latitude},pm2rdm` // метка на карте
	});

	return `${baseUrl}?${params.toString()}`;
}

</script>
<style lang="scss">
	@use './map.sass';
</style>
