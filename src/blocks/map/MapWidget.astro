---
import settings from '@/data/site/settings.json';
const { yandex_widget_orgnization, map_background } = settings;

interface Props{
	widgetId?: string;
	mapImg?: string;
	class?: string;
}
const {mapImg = map_background, class: className = '', widgetId = yandex_widget_orgnization, ...rest} = Astro.props

import './map.sass';
---
<div style={`background-image: url(${mapImg})`} class={`relative overflow-hidden w-full flex items-center justify-center bg-gray-100 bg-cover bg-center z-10 cursor-pointer ${className}`} {...rest} id="map-widget-wrapper" data-widget-id={widgetId}>
	<div class="loader loader-default"></div>
	<div id="map-widget" class="h-full w-full flex items-center justify-center"></div>
</div>

<script>
	import { LINK_WIDGET } from '@/const';
	import { observeMap, showMapError } from '@/js/utils/lazyMap';
	const wrapper = document.getElementById('map-widget-wrapper');
	const widget = document.getElementById('map-widget');
	const widgetId = wrapper?.dataset.widgetId;
	let loaded = false;
	let loading = false;

	function loadWidget() {
		if (!wrapper || !widget || !widgetId || loaded || loading) return;
		loading = true;
		wrapper.classList.add('is-active');
		const iframe = document.createElement('iframe');
		iframe.className = 'absolute w-full h-full z-20';
		iframe.title = 'Карта расположения автосалона';
		const timer = setTimeout(fail, 20000);
		function fail() {
			clearTimeout(timer);
			iframe.onload = null;
			iframe.onerror = null;
			iframe.remove();
			loading = false;
			wrapper.classList.remove('is-active');
			showMapError(widget, loadWidget);
		}
		iframe.onload = () => {
			clearTimeout(timer);
			loaded = true;
			loading = false;
			wrapper.style.backgroundImage = '';
			wrapper.classList.remove('is-active');
			wrapper.removeEventListener('mouseenter', loadWidget);
		};
		iframe.onerror = fail;
		iframe.src = LINK_WIDGET + widgetId;
		widget.replaceChildren(iframe);
	}

	if (wrapper && widgetId) {
		wrapper.addEventListener('mouseenter', loadWidget);
		wrapper.addEventListener('click', loadWidget);
		observeMap(wrapper, loadWidget);
	}
</script>
