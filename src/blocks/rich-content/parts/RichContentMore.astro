---
import CollapsibleText from '@/ui/collapsible-text/CollapsibleText.astro';

interface Props {
	value?: string;
}

const { value = '' } = Astro.props;
---

{value && (
	<CollapsibleText
		mode="height"
		collapsedHeight="var(--rich-content-collapsed-height)"
		fade
		class="rich-content-more"
		contentClass="space-y-4 my-8"
		collapsedContentClass="seo-content"
		buttonClass="underline cursor-pointer"
	>
		<Fragment set:html={value} />
	</CollapsibleText>
)}

<style is:global>
	collapsible-text.rich-content-more { --rich-content-collapsed-height: 90px; }
	@media (min-width: 64rem) {
		collapsible-text.rich-content-more { --rich-content-collapsed-height: 55px; }
	}
</style>
