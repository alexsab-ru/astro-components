---
import FaqItem from './FaqItem.astro';
import { type TFaqItem } from './types';
interface Props {
	items: TFaqItem[];
	title?: string;
	class?: string;
	id?: string;
	withSchema?: boolean;
	schema?: boolean;
	layout?: 'accordion' | 'headings';
}
const {
	items = [],
	title,
	class: classNames = '',
	id = 'faq',
	withSchema = false,
	schema = false,
	layout = 'accordion',
} = Astro.props;

const shouldRenderSchema = withSchema || schema;
const showAsHeadings = layout === 'headings';
const faqItems = items.map((item, index) => ({
	...item,
	id: item.id ?? index + 1,
	open: Boolean(item.open),
}));
const normalizeSchemaText = (value: string) =>
	value
		.replace(/<[^>]*>/g, ' ')
		.replace(/&nbsp;/g, ' ')
		.replace(/&amp;/g, '&')
		.replace(/&quot;/g, '"')
		.replace(/&#39;/g, "'")
		.replace(/&lt;/g, '<')
		.replace(/&gt;/g, '>')
		.replace(/\s+/g, ' ')
		.trim();

const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqItems.map((item) => ({
		'@type': 'Question',
		name: normalizeSchemaText(item.question),
		acceptedAnswer: {
			'@type': 'Answer',
			text: normalizeSchemaText(item.answer),
		},
	})),
};
---

{
	faqItems.length > 0 && (
		<>
			<section
				class={`faq ${classNames}`}
				id={id}
				x-data={showAsHeadings ? undefined : '{activities:[]}'}
			>
				<div class="section-grid">
					{title && (<h2 class="text-xl sm:text-4xl mb-8 sm:mb-14">{title}</h2>)}

					{faqItems.map((item) => showAsHeadings ? (
						<div class="mb-3 rounded-md border border-gray-200 px-5 py-4">
							<h2 class="text-sm font-weight-bold md:text-lg">{item.question}</h2>
							<h3 class="mt-2 text-sm font-normal leading-relaxed md:text-base">{item.answer}</h3>
						</div>
					) : (
						<FaqItem item={item} />
					))}
				</div>
			</section>

			{shouldRenderSchema && (
				<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
			)}
		</>
	)
}
