---
import IconFeatureCard from './IconFeatureCard.astro';
import { type IconFeatureCardData  } from './types';
interface Props {
	items: IconFeatureCardData[];
	title?: string;
	class?: string;
	id?: string
	show?: boolean
}
const { items = [], title, class: classNames = '', id, show = true, ...rest } = Astro.props;
---
{show && items.length > 0 && (
<section class={classNames} id={id} {...rest}>
	<div class="section-grid">
		{title && (<h2 class="text-xl sm:text-4xl mb-8 sm:mb-14">{title}</h2>)}
		<div class="flex justify-center flex-wrap gap-y-10">
			{items.map(item => <IconFeatureCard item={item} />)}
		</div>
	</div>
</section>
)}
