---
import ImageFeatureCard from './ImageFeatureCard.astro';
import { type ImageFeatureCardData  } from './types';
interface Props {
	items: ImageFeatureCardData[];
	title?: string;
	id?: string;
}
const { items = [], title, id } = Astro.props;
---
{items.length > 0 && (
<section class="" id={id}>
	<div class="section-grid">
		{title && (<h2 class="text-xl sm:text-4xl mb-8 sm:mb-14">{title}</h2>)}
		<div class="grid grid-cols-1 md:grid-cols-2 gap-x-5 xs:gap-y-2 gap-y-4 sm:gap-y-5">
			{items.map(item => <ImageFeatureCard item={item} />)}
		</div>
	</div>
</section>
)}
