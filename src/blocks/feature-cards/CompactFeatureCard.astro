---
import { Icon } from 'astro-icon/components';
import CardAction from '@/ui/card-action/CardAction.astro';
import type { CompactFeatureCardData } from './types';
interface Props { item: CompactFeatureCardData; }
const { item } = Astro.props;
---
<CardAction
	source={item}
	class="rounded-lg bg-gray-100 p-1.5 sm:p-3 flex items-center flex-nowrap gap-1 sm:gap-2 shadow-lg transition-shadow hover:shadow-md"
>
	{item.icon && <Icon name={item.icon} class="text-gray-800 shrink-0 text-2xl sm:text-[44px]" title={item.title} />}
	<span class="block text-xs sm:text-lg 2xl:text-xl">{item.title}</span>
</CardAction>
