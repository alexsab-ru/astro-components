---
import { render } from 'astro:content';
import { getSafeEntry } from '@/js/utils/safeContent';
import CollapsibleText from '@/ui/collapsible-text/CollapsibleText.astro';

interface Props {
  mdx?: string;
  text?: string;
  noPadding?: boolean;
  sectionPaddingBlock?: boolean;
}

const { mdx, text, noPadding = false, sectionPaddingBlock = false } = Astro.props;

// Приоритет у inline-текста; mdx-файл подтягивается только если text пуст.
const hasText = typeof text === 'string' && text.trim().length > 0;

let Content = null;
if (!hasText && mdx) {
  const content = await getSafeEntry('seo', mdx);
  if (content) {
    const result = await render(content);
    Content = result.Content;
  }
}

const showseo = hasText || Content !== null;
---

{ showseo ? (
<section class={`${!sectionPaddingBlock ? 'pt-0!' : ''}`}>
	<div class={`container ${noPadding ? 'px-0!' : ''}`}>
		<CollapsibleText
			mode="height"
			collapsedHeight="230px"
			fade
			expandLabel="читать полностью"
			collapseLabel="скрыть"
			contentClass="seo-content"
			buttonClass="seo-show-more no-underline!"
			actionsClass="flex justify-center mt-6"
			scroll="collapse"
		>
			{hasText ? <Fragment set:html={text} /> : <Content />}
			<span slot="toggle-icon" class="seo-show-more-arrow" aria-hidden="true">&#187;</span>
		</CollapsibleText>
	</div>
</section>
) : ('')}
