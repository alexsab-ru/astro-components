---
import ImageGallery from './ImageGallery.astro';
import type { GalleryImageData } from './types';

interface Props {
	images: GalleryImageData[];
	gallery?: string;
	title?: string;
}

const { images, gallery, title } = Astro.props;
---

<ImageGallery images={images} gallery={gallery} title={title} layout="simple" descriptionMode="html" />
