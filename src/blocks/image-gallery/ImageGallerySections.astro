---
import Grid from './ImageGalleryGrid.astro';
import SimpleGrid from './ImageGallerySimpleGrid.astro';
import { createGalleryGroup } from './gallery-data.js';
import type { GalleryImageData } from './types';

interface Section {
  id: string;
  content?: {
    title?: string;
    images?: GalleryImageData[];
  };
}

interface Props {
  sections: Section[];
  variant?: 'grid' | 'simple';
  ctaHref?: string;
  ctaText?: string;
}

const { sections, variant = 'grid', ctaHref, ctaText = 'Узнать подробности' } = Astro.props;
const instance = createGalleryGroup();

const filteredSections = sections.filter((section) => section.content?.images?.length);
const ctaAfterIndex = Math.floor(filteredSections.length / 2) - 1;
---

{filteredSections.map((section, index) => (
  <>
    <section class="">
      <h2 class="text-2xl sm:text-4xl font-bold mb-6">{section.content?.title}</h2>
      {variant === 'simple' ? (
        <SimpleGrid
          images={section.content?.images as GalleryImageData[]}
          gallery={`${instance}-${section.id}`}
          title={section.content?.title}
        />
      ) : (
        <Grid
          images={section.content?.images as GalleryImageData[]}
          gallery={`${instance}-${section.id}`}
        />
      )}
    </section>
    {ctaHref && index === ctaAfterIndex && (
      <div class="text-center my-12">
        <a
          href={ctaHref}
          class="btn inline-block py-3 px-8 text-lg bg-accent-500 text-white rounded-lg transition hover:bg-accent-600"
        >
          {ctaText}
        </a>
      </div>
    )}
  </>
))}
