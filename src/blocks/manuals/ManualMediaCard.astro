---
// Плитка руководства с изображением модели (вариант бренда Toyota).
import CardMedia from '@/ui/card-media/CardMedia.astro';

interface Props {
	image?: string;
	name: string;
	url: string;
	imgPlacement?: 'left' | 'right';
	thumbnailWidth?: string;
}
const {
	image,
	name,
	url,
	imgPlacement = 'left',
	thumbnailWidth = '12rem',
} = Astro.props;
---

<CardMedia
	imgPlacement={imgPlacement}
	images={image ? [{ imageUrl: image, alt: name }] : []}
	mediaVariant="thumbnail"
	thumbnailWidth={thumbnailWidth}
	buttons={[
		{ title: 'Посмотреть', action: { type: 'new-tab', url } },
		{ title: 'Скачать', url, download: true },
	]}
>
	<Fragment slot="card-heading">
		<h2 class="m-0! p-0! before:hidden text-xl! lg:text-3xl!">
			Руководство по эксплуатации{' '}
			<span class="font-semibold">{name}</span>
		</h2>
	</Fragment>
</CardMedia>
