---
import type { ModelProps } from './types';
import ModelHero from './ModelHero.astro';
import ModelColors from './ModelColors.astro';
import ModelPhotos from './ModelPhotos.astro';
import ModelCharacteristics from './ModelCharacteristics.astro';
import ModelActions from './ModelActions.astro';
import { resolveModelOrder, isModelPartVisible } from './model-layout.js';
import './model.css';
interface Props extends ModelProps {}
const {
	model,
	breadcrumb,
	status,
	id = model?.id,
	photos,
	parts,
	partOrder,
	eyebrow,
	actions,
	actionPreset,
	excludeActions,
	testDriveEnabled,
	creditEnabled,
} = Astro.props;
const order = resolveModelOrder(partOrder);
const visibleOrder = order.filter((key) => isModelPartVisible(parts, key));
---

{visibleOrder.length > 0 && (
	<section
		class="model model-section relative"
		id={id}
		data-dir={model?.id}
	>
		{visibleOrder.map((key) => {
			switch (key) {
				case 'hero':
					return (
						<ModelHero
							model={model}
							breadcrumb={breadcrumb}
							status={status}
							parts={parts}
							eyebrow={eyebrow}
						/>
					);
				case 'colors':
					return <ModelColors model={model} />;
				case 'media':
					return (
						<ModelPhotos
							model={model}
							photos={photos}
						/>
					);
				case 'characteristics':
					return <ModelCharacteristics model={model} />;
				case 'actions':
					return (
						<ModelActions
							model={model}
							status={status}
							creditEnabled={creditEnabled}
							testDriveEnabled={testDriveEnabled}
							preset={actionPreset}
							actions={actions}
							excludeActions={excludeActions}
						/>
					);
			}
		})}
	</section>
)}
