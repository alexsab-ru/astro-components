---
import type { ModelProps } from './types';
import ModelHero from './ModelHero.astro';
import ModelBadge from './ModelBadge.astro';
import ModelMedia from './ModelMedia.astro';
import ModelColorPicker from './ModelColorPicker.astro';
import ModelPhotos from './ModelPhotos.astro';
import ModelCharacteristics from './ModelCharacteristics.astro';
import ModelActions from './ModelActions.astro';
import { resolveModelOrder, isModelPartVisible } from './model-layout.js';
import './model.css';
interface Props extends ModelProps {}
const {
	model,
	breadcrumb,
	status,
	id = model?.id,
	photos,
	parts,
	partOrder,
	heroOrder,
	creditEnabled,
} = Astro.props;
const order = resolveModelOrder(partOrder);
const visibleOrder = order.filter((key) => isModelPartVisible(parts, key));
---

{visibleOrder.length > 0 && (
	<section
		class="model model-section relative"
		id={id}
		data-dir={model?.id}
	>
		{isModelPartVisible(parts, 'badge') &&
			isModelPartVisible(parts, 'hero') && <ModelBadge model={model} />}
		{visibleOrder.map((key) => {
			switch (key) {
				case 'hero':
					return (
						<ModelHero
							model={model}
							breadcrumb={breadcrumb}
							status={status}
							parts={parts}
							heroOrder={heroOrder}
						/>
					);
				case 'media':
					return <ModelMedia model={model} />;
				case 'colors':
					return <ModelColorPicker model={model} />;
				case 'photos':
					return (
						<ModelPhotos
							model={model}
							photos={photos}
						/>
					);
				case 'characteristics':
					return <ModelCharacteristics model={model} />;
				case 'actions':
					return (
						<ModelActions
							model={model}
							status={status}
							creditEnabled={creditEnabled}
						/>
					);
			}
		})}
	</section>
)}
