---
import { randomUUID } from 'node:crypto';
import {
	getModelBrandDisplayName,
	getModelTitle,
} from '@/js/utils/modelFields';
import { loadModelPhotos } from './model-photos.js';
import './model.css';
interface Props {
	model: any;
	photos?: string[];
	gallery?: string;
}
const { model, photos, gallery = `model-photos-${randomUUID()}` } = Astro.props;
const photoSlides = photos ?? (await loadModelPhotos(model.photos));
---

{photoSlides.length > 0 && (
	<div
		data-model-part="photos"
		class="container px-0 sm:px-5"
	>
		<div class="swiper photo-slider h-[120px] md:h-[200px] mt-14">
			<div class="swiper-wrapper">
				{photoSlides.map((photo, index) => (
					<a
						href={photo}
						class="swiper-slide glightbox image-slide"
						data-gallery={gallery}
					>
						<img
							src={photo}
							loading="lazy"
							height="200"
							alt={`${getModelBrandDisplayName(model)} ${getModelTitle(model)}, фото ${index + 1}`}
						/>
						<div class="swiper-lazy-preloader" />
					</a>
				))}
			</div>
		</div>
	</div>
)}

<script>
	import './model-photos-slider.js';
</script>
