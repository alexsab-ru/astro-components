---
import {
	getModelBrandDisplayName,
	getModelTitle,
	getModelColorImage,
} from '@/js/utils/modelFields';
interface Props {
	model: any;
}
const { model } = Astro.props;
const modelTitle = getModelTitle(model);
const brandDisplayName = getModelBrandDisplayName(model);
const carImagePath =
	getModelColorImage(model.colors?.[0]) ||
	`/img/${model.id}/${model.colors?.[0]?.id}.png`;
---

<div
	data-model-part="media"
	class={`w-full lg:w-3/4 2xl:w-3/5 relative z-10 top-4 mx-auto`}
>
	<div class="flex flex-col justify-center">
		<div class="lazy aspect-1143/493">
			<img
				src="https://img.upspace.ru/loaders/simple-loading.svg"
				data-src={carImagePath}
				class="w-full color-img-preview"
				width="1143"
				height="493"
				alt={`${brandDisplayName} ${modelTitle}`}
				fetchpriority="high"
			/>
		</div>
	</div>
</div>
