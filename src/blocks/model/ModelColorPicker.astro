---
import ColorLink from '@/ui/color-link/ColorLink.astro';
import { getModelColorImage } from '@/js/utils/modelFields';
interface Props {
	model: any;
}
const { model } = Astro.props;
---

<div
	data-model-part="colors"
	class="w-full lg:w-3/4 2xl:w-3/5 relative z-10 top-4 mx-auto"
>
	<div class="flex flex-wrap justify-center gap-4 sm:gap-5 color-links">
		{model.colors &&
			model.colors.map((c: any, idx: number) => (
				<ColorLink
					title={c.name}
					id={c.id}
					idx={idx}
					carImage={getModelColorImage(c)}
					style={c.style}
				/>
			))}
		<p class="w-full text-center text-xs color-name text-black">
			{model.colors?.[0]?.name}
		</p>
	</div>
</div>
