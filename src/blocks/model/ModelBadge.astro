---
import { getModelBadgeData } from '@/js/utils/modelBadge';
import { getModelTitle } from '@/js/utils/modelFields';
interface Props {
	model: any;
}
const { model } = Astro.props;
const {
	image: badgeImage,
	alt: badgeAlt,
	classes: badgeClasses,
} = getModelBadgeData(model, 'modelPage', getModelTitle(model) || '');
---

{badgeImage && (
	<img
		data-model-part="badge"
		src={badgeImage}
		alt={badgeAlt}
		class={`absolute right-4 top-4 h-auto z-10 object-contain ${badgeClasses}`}
		loading="lazy"
	/>
)}
