---
import Button from '@/ui/button/Button.astro';
import settings from '@/data/site/settings.json';
import { isCreditEnabled } from '@/js/utils/features';
import {
	getModelBrandDisplayName,
	getModelTitle,
} from '@/js/utils/modelFields';
import type { TStatus } from '@/types/TStatus';
interface Props {
	model: any;
	status?: TStatus;
	creditEnabled?: boolean;
}
const {
	model,
	status,
	creditEnabled = isCreditEnabled(settings),
} = Astro.props;
const modelTitle = getModelTitle(model);
const brandDisplayName = getModelBrandDisplayName(model);
---

<div
	data-model-part="actions"
	class="container"
>
	{(status === 'enable' || status === 'show' || model?.show) && (
		<div class="flex justify-center flex-wrap xs:flex-col gap-4 mt-14">
			<Button
				classes="popup-link btn black btn-o px-4! flex-1 whitespace-nowrap"
				url="#common-modal"
				title="Купить"
				dataTitle={`Купить ${brandDisplayName}`}
				dataFormName={`Купить. ${brandDisplayName} ${modelTitle}`}
			/>
			{creditEnabled && (
				<Button
					classes="popup-link btn px-4! flex-1 whitespace-nowrap"
					url="#common-modal"
					title="Рассчитать кредит"
					dataTitle="Рассчитать кредит"
					dataFormName={`Рассчитать кредит. ${brandDisplayName} ${modelTitle}`}
				/>
			)}
			<Button
				classes="popup-link btn gray px-4! flex-1 whitespace-nowrap"
				url="#common-modal"
				title="Записаться на тест-драйв"
				dataTitle="Записаться на тест-драйв"
				dataFormName={`Записаться на тест-драйв. ${brandDisplayName} ${modelTitle}`}
			/>
			<Button
				classes="popup-link btn black px-4! flex-1 whitespace-nowrap"
				url="#common-modal"
				title="Узнать цену по акции"
				dataTitle="Узнать цену по акции"
				dataFormName={`Узнать цену по акции. ${brandDisplayName} ${modelTitle}`}
			/>
			{model?.complectations !== undefined &&
			model?.complectations.length ? (
				<Button
					classes="btn black btn-o px-4! flex-1 whitespace-nowrap"
					view="scroll-link"
					url="#complectation"
					title="Подобрать комплектацию"
				/>
			) : (
				<Button
					classes="popup-link btn black btn-o px-4! flex-1 whitespace-nowrap"
					url="#common-modal"
					title="Подобрать комплектацию"
					dataTitle="Подобрать комплектацию"
					dataFormName={`Подобрать комплектацию. ${brandDisplayName} ${modelTitle}`}
				/>
			)}
		</div>
	)}
</div>
