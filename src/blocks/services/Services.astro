---
import CompactFeatureCards from '@/blocks/feature-cards/CompactFeatureCards.astro';
import type { CompactFeatureCardData } from '@/blocks/feature-cards/types';
import servicesData from '@/data/site/services.json';
interface Props { title?: string; services?: CompactFeatureCardData[]; }
const { title = 'Услуги дилерского центра', services = servicesData, ...rest } = Astro.props;
---
<CompactFeatureCards items={services} title={title} id="services" {...rest} />
