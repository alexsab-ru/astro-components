---
import type { TBrandItem } from './types';

interface Props {
  items: TBrandItem[];
}

const { items } = Astro.props;
---

<div class="flex flex-wrap gap-2 p-2">
  {items.map((item: TBrandItem) => (
    <a
      href={item.href}
      target={item.target}
      rel={item.rel}
      data-title={item.isPopup ? item.displayName : undefined}
      data-form_name={item.isPopup ? `${item.displayName}. Бренды` : undefined}
      class={`flex items-center object-contain w-[70px] no-underline! ${item.isPopup ? 'popup-link' : ''}`}>
      <img src={item.whiteLogo} alt={item.displayName} loading="lazy" class="h-auto w-full filter brightness-0 invert opacity-70" />
    </a>
  ))}
</div>
