---
import { declOfNums } from '@/js/utils/numbers.format';
import type { TBrandItem } from './types';

interface Props {
  items: TBrandItem[];
}

const { items } = Astro.props;
---
<div class="flex flex-wrap mb-10 lg:mb-20 last:mb-0 lg:gap-5 text-xs 2xl:text-base justify-between lg:justify-center">
  {
    items.map((item: TBrandItem) => (
    <a
      href={item.href}
      target={item.target}
      rel={item.rel}
      data-title={item.isPopup ? item.displayName : undefined}
      data-form_name={item.isPopup ? `${item.displayName}. Бренды` : undefined}
      class={`mb-[4%] lg:mb-0 w-[48%] lg:w-[calc(33.33%-calc(40px/3))] xl:w-[calc(25%-calc(60px/4))] flex flex-col justify-center items-center border p-3 sm:pt-10 sm:pb-4 sm:px-5 overflow-hidden shadow-xl transition-all duration-500 in-expo group hover:border-gray-400 hover:shadow-md no-underline! ${item.isPopup ? 'popup-link' : ''}`}>
      <div class="flex items-center object-contain mb-8"><img src={item.colorLogo} alt={item.displayName} loading="lazy" class="h-auto w-full" /></div>
      <div class="uppercase font-weight-bold text-base md:text-xl mb-2">{item.id}</div>
      {item.count ? (<div class="text-center md:text-base md:font-weight-bold">{declOfNums(item.count)}</div>) : null}
    </a>
    ))
  }
</div>
