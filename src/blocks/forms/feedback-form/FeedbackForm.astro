---
import Form from './FeedbackFormFields.astro';
import FeedbackFormGallery from './FeedbackFormGallery.astro';
import type { FeedbackFormImage } from './FeedbackFormGallery.astro';

interface Props {
	title?: string;
	subtitle?: string;
	imageUrl?: string;
	/** Массив фотографий для мозаики. Непустой массив имеет приоритет над imageUrl. */
	images?: (string | FeedbackFormImage)[];
	labelBtn?: string;
	dataFormName?: string;
	showModelSelect?: boolean;
}

const defaultTitle = 'Узнать подробнее';
const defaultDataFormName = 'Форма обратной связи на странице';

const {
	title, // undefined если не передан, "" если нужно скрыть, или строка для отображения
	subtitle = '',
	imageUrl = '',
	images = [],
	labelBtn,
	dataFormName = '',
	showModelSelect = false,
} = Astro.props;

// Определяем заголовок для отображения (undefined -> defaultTitle, "" -> скрываем, "текст" -> показываем)
const displayTitle = title ?? defaultTitle;
const galleryImages = images
	.map((image) => (typeof image === 'string' ? { imageUrl: image } : image))
	.filter((image) => image.imageUrl.trim().length > 0);
const hasGallery = galleryImages.length > 0;
const Heading = hasGallery ? 'h2' : 'h3';
// Определяем название формы: приоритет dataFormName, потом title (если не пустой), потом defaultDataFormName
const formName = dataFormName || title || defaultDataFormName;
---
{
	hasGallery || imageUrl.length ? (
		<div
			class:list={[
				'feedback-form',
				hasGallery
					? 'feedback-form--gallery'
					: 'flex flex-col lg:flex-row lg:gap-10 lg:items-center lg:justify-center',
			]}
		>
			{hasGallery ? (
				<FeedbackFormGallery images={galleryImages} />
			) : (
				<div class="lazy mb-8 lg:mb-0 justify-center lg:w-1/2">
					<img
						src="https://cdn.alexsab.ru/loaders/simple-loading-gray.svg"
						data-src={imageUrl}
						alt={title ?? ''}
						class="w-full h-auto"
						loading="lazy"
						width="748"
						height="323"
					/>
				</div>
			)}
			<div class:list={{ 'feedback-form__content': hasGallery }}>
				{title !== '' && (
					<Heading
						class:list={[
							'text-3xl! sm:text-4xl!',
							hasGallery ? 'feedback-form__title' : 'text-center mb-8!',
						]}
					>
						{displayTitle}
					</Heading>
				)}
				{subtitle.length > 0 && (
					<p class:list={[hasGallery ? 'feedback-form__subtitle' : 'text-center mb-8']}>
						<Fragment set:html={subtitle} />
					</p>
				)}
				<Form
					dataFormName={formName}
					showModelSelect={showModelSelect}
					labelBtn={labelBtn}
				/>
			</div>
		</div>
	) : (
		<>
			{title !== '' && (
				<h3 class="text-center text-3xl! sm:text-4xl! mb-8!">{displayTitle}</h3>
			)}
			{subtitle.length > 0 && <p class="text-center mb-8">{subtitle}</p>}
			<Form
				dataFormName={formName}
				showModelSelect={showModelSelect}
				labelBtn={labelBtn}
			/>
		</>
	)
}

<style>
	.feedback-form--gallery {
		display: grid;
		gap: 2rem;
		align-items: center;
	}

	.feedback-form__content {
		min-width: 0;
	}

	.feedback-form__title {
		margin: 0 0 1rem;
		padding: 0;
		text-align: left;
		text-transform: uppercase;
	}

	.feedback-form__title::before {
		display: none;
	}

	.feedback-form__subtitle {
		margin-bottom: 1.5rem;
	}

	.feedback-form__content :global(form) {
		max-width: none;
		margin-inline: 0;
	}

	@media (min-width: 64rem) {
		.feedback-form--gallery {
			grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
			gap: 2.5rem;
		}
	}
</style>
