---
import Button from '@/ui/button/Button.astro';
import LeadForm from '../lead-form/LeadForm.astro';
import ContactFields from '../lead-form/ContactFields.astro';
import ConsentFields from '../lead-form/ConsentFields.astro';
import FormSelect from '@/ui/form-select/FormSelect.astro';
import ChoosingDealerSelect from '@/ui/choosing-dealer-select/ChoosingDealerSelect.astro';
import settings from '@/data/site/settings.json';
const { agree_label } = settings;

import salonsData from '@/data/site/salons.json';
import type { ISalon } from '@/types/ISalon';
const salons = salonsData.filter(
	(salon: ISalon) => !salon?.type || salon?.type.includes('test_drive')
);
interface Props {
	dataFormName?: string;
	showModelSelect?: boolean;
	labelBtn?: string;
}
const {
	dataFormName,
	showModelSelect = false,
	labelBtn = 'Отправить',
} = Astro.props;

import modelsData from '@/data/site/models.json';
import { isModelVisible } from '@/js/utils/modelVisibility';
import {
	getModelBrandDisplayName,
	getModelBrandId,
	getModelTitle,
} from '@/js/utils/modelFields';
import { normalizeModelId } from '@/js/utils/normalizeModelId';
// brandId и modelIdNormalized нужны селекту, чтобы вынести модели нужной марки
// наверх и подставить запомненный автомобиль. По name/caption это не сделать:
// там человекочитаемые подписи.
const options = (modelsData.service || [])
	.filter(isModelVisible)
	.map((model) => ({
		id: `${getModelBrandId(model)}-${model.id}`.toLowerCase(),
		name: `${getModelBrandDisplayName(model)} ${model.name}`,
		caption: `${getModelBrandDisplayName(model)} ${getModelTitle(model)}`,
		brandId: getModelBrandId(model),
		modelIdNormalized: normalizeModelId(model.id),
	}));
---

<LeadForm
	class="flex flex-col gap-4 max-w-[500px] mx-auto"
	formName={dataFormName}
>
	{
		showModelSelect && (
			<FormSelect
				name="model"
				placeholder="Выберите модель"
				options={options}
				brandSort
			/>
		)
	}

	<ContactFields phoneField={{ errorClasses: 'text-red-500' }} />

	<ChoosingDealerSelect
		required={true}
		salons={salons}
		pageData
	/>

	<ConsentFields
		label={agree_label}
		color="black"
		errorClasses="text-red-500 w-full"
	/>

	<Button
		view="form-button"
		classes="w-full"
		title={labelBtn}
	/>
</LeadForm>
