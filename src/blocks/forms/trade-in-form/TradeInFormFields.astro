---
import Button from '@/ui/button/Button.astro';
import Input from '@/ui/input/Input.astro';
import LeadForm from '../lead-form/LeadForm.astro';
import ContactFields from '../lead-form/ContactFields.astro';
import ConsentFields from '../lead-form/ConsentFields.astro';
import Textarea from '@/ui/textarea/Textarea.astro';
import FormSelect from '@/ui/form-select/FormSelect.astro';
import settings from '@/data/site/settings.json';
const { agree_label } = settings;
import modelsData from '@/data/site/models.json';
import {
	getModelBrandDisplayName,
	getModelBrandId,
	getModelTitle,
} from '@/js/utils/modelFields';
import { isModelVisible } from '@/js/utils/modelVisibility';
const options = (modelsData.service || [])
	.filter(isModelVisible)
	.map((model) => ({
		id: `${getModelBrandId(model)}-${model.id}`.toLowerCase(),
		name: `${getModelBrandDisplayName(model)} ${getModelTitle(model)}`,
	}));

const gearboxOptions = [
	{ id: 'option1', name: 'Механическая' },
	{ id: 'option2', name: 'Автоматическая' },
	{ id: 'option3', name: 'Вариатор' },
	{ id: 'option4', name: 'Роботизированная коробка передач' },
];
---

<LeadForm
	class="flex flex-col gap-4 max-w-[500px] mx-auto js-trade-in-form"
	formName="tradeInForm"
>
	<p><strong>Ваш автомобиль</strong></p>
	<Input
		name="brandAndModel"
		classes="border-gray-100"
		required
		placeholder="Марка и модель вашего авто*"
		errorText="Пожалуйста, укажите марку и модель Вашего авто"
	/>
	<Input
		name="year"
		classes="border-gray-100"
		required
		placeholder="Год выпуска*"
		errorText="Пожалуйста, укажите год выпуска Вашего авто"
	/>
	<Input
		name="mileage"
		classes="border-gray-100"
		required
		placeholder="Пробег*"
		errorText="Пожалуйста, укажите пробег Вашего авто"
	/>
	<FormSelect
		name="gearbox"
		required
		placeholder="Коробка передач*"
		options={gearboxOptions}
		errorMessage="Пожалуйста, выберите КПП Вашего авто"
	/>
	<Input
		name="cost"
		classes="border-gray-100"
		required
		placeholder="Желаемая стоимость*"
		errorText="Пожалуйста, укажите желаемую стоимость"
	/>
	<p><strong>Желаемый автомобиль</strong></p>
	<FormSelect
		name="model"
		required
		placeholder="Модель*"
		options={options}
		errorMessage="Пожалуйста, выберите модель желаемого авто"
	/>
	<ContactFields
		phoneField={{ errorText: 'Телефон является обязательным полем' }}
	/>
	<Textarea
		name="comment"
		classes="border-gray-100 min-h-[100px] h-auto resize-none"
		placeholder="Комментарий"
	/>

	<ConsentFields
		label={agree_label}
		color="black"
		subscribe={false}
	/>

	<Button
		view="form-button"
		classes="w-full"
		title="Отправить"
	/>
</LeadForm>
