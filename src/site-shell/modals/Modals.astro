---
import type { ComponentProps } from 'astro/types';
import LeadFormModal from './LeadFormModal.astro';
import MessageModal from './MessageModal.astro';
import RepeatRequestModal from './RepeatRequestModal.astro';
import FileDeleteModal from './FileDeleteModal.astro';
interface Props {
	showLeadForm?: boolean;
	leadForm?: Omit<ComponentProps<typeof LeadFormModal>, 'id'>;
}
const { showLeadForm = true, leadForm = {} } = Astro.props;
---

{showLeadForm && (
	<LeadFormModal
		{...leadForm}
		id="common-modal"
	/>
)}
<MessageModal />
<RepeatRequestModal />
<FileDeleteModal />
<slot />
