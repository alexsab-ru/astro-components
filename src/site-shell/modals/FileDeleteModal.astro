---
import Modal from '@/ui/modal/Modal.astro';
---

<Modal
	id="dropzone-confirm-modal"
	role="alertdialog"
	aria-label="Удаление файла"
	aria-describedby="dropzone-confirm-text"
	size="wide"
	backdrop="soft"
	closeColor="accent-500"
>
	<p
		id="dropzone-confirm-text"
		class="text-center text-lg mb-10 message"
	></p>
	<div class="flex justify-center flex-wrap gap-5">
		<button
			type="button"
			id="dropzone-accept"
			class="btn accent"
		>
			Удалить
		</button>
		<button
			type="button"
			id="dropzone-cancel"
			class="btn gray"
		>
			Отмена
		</button>
	</div>
</Modal>
