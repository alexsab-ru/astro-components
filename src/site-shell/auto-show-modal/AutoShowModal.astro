---
import Button from '@/ui/button/Button.astro';
import Input from '@/ui/input/Input.astro';
import Checkbox from '@/ui/checkbox/Checkbox.astro';
import CloseModalBtn from '@/ui/close-modal-btn/CloseModalBtn.astro';
import FormSelect from '@/ui/form-select/FormSelect.astro';
import settings from '@/data/site/settings.json';
const { manager_photo, agree_label } = settings;

const { 
	modalShow = 20000,
	title = '',
	subtitle = '',
	testDrive = false,
	modalPosition = 'center',
	desktopBottomRight = false,
	img = manager_photo,
	imgPosition = 'right',
	formName = ''
} = Astro.props;

import modelsData from '@/data/site/models.json';
import { getModelTitle } from '@/js/utils/modelFields';
import { isModelVisible } from '@/js/utils/modelVisibility';
const { models } = modelsData;
const options = testDrive
	? models
		.filter(isModelVisible)
		.filter((m: any) => m?.testDrive)
		.map((m: any) => ({
			...m,
			name: getModelTitle(m),
		}))
	: [];
---

<div
	class={`modal fixed max-w-[700px] w-full max-h-dvh overflow-y-auto overflow-x-hidden overscroll-y-contain bg-white z-10000 hidden ${modalPosition !== 'center' ? 'shadow-4xl' : ''}`}
	data-position={modalPosition}
	data-desktop-bottom-right={desktopBottomRight ? '' : undefined}
	id="common-modal-with-img"
>

	<CloseModalBtn variant="outlined" />

	<div class="flex flex-col sm:grid grid-cols-5">

		{imgPosition === 'left' && img ? (
			<div class="max-sm:order-first col-span-2 relative left bg-gray-100">
				<img data-src={img} class="h-auto sm:h-full max-h-[80vh] w-full object-cover object-top sm:object-center" id="lazy-image" alt="ALT" width="280" height="702" />
			</div>
		) : ('')}

		<div class="col-span-3 p-5 pt-10 sm:p-8">
			{title && (<p class="title text-xl sm:text-3xl mb-8 text-gray-800"><Fragment set:html={title} /></p>)}
			{subtitle && (<p class="subtitle mb-8 text-gray-600"><Fragment set:html={subtitle} /></p>)}
			<form class="flex flex-col gap-4" id="auto-show-modal-form" novalidate>
				<input type="hidden" name="form" value={formName} />
				<input
					type="email"
					tabindex="-1"
					name="email"
					class="h-0 opacity-0 absolute -z-100"
					placeholder="mail@example.com"
				/>
				<Input
				type="tel"
				name="phone"
				classes="border-gray-100"
				placeholder="+7 (999) 999-99-99*"
				required
				errorClasses="text-red-500"
				/>
				
				{testDrive && <FormSelect name="model" placeholder="Выберите модель" options={options} />}

				<Input name="name" classes="border-gray-100" placeholder="Ваше имя" />

				<Checkbox
					name="agree"
					label={agree_label}
					color="black"
					required
					errorClasses="text-red-500 w-full"
					errorText="Чтобы продолжить, установите флажок"
				/>

				<input
					type="checkbox"
					name="subscribe"
					class="absolute w-0 h-0 opacity-0 invisible"
				/>

				<Button view="form-button" classes="w-full" title="Отправить" />
			</form>
		</div>

		{imgPosition === 'right' && img ? (
			<div class="max-sm:order-first col-span-2 relative left bg-gray-100">
				<img data-src={img} class="h-auto sm:h-full max-h-[80vh] w-full object-cover object-top sm:object-center" id="lazy-image" alt="ALT" width="280" height="702" />
			</div>
		) : ('')}

	</div>

</div>

<div
	class:list={['fixed inset-0 overflow-x-hidden overflow-y-auto bg-black/70 z-9999 hidden', desktopBottomRight && 'md:hidden']}
	id="modal-overlay"
	data-close
></div>

<script define:vars={{ showDelay: modalShow, position: modalPosition }} is:inline>
	const modal = document.getElementById('common-modal-with-img');
	const overlay = document.getElementById('modal-overlay');
	const lazyImage = modal.querySelector('#lazy-image');
	const storageKey = 'auto-show-modal-dismissals';
	const dismissalDelay = 20_000;
	const maxDismissals = 3;
	let dismissals = 0;
	let showTimer;

	function scheduleShow() {
		try {
			dismissals = Number(sessionStorage.getItem(storageKey)) || 0;
		} catch {
			// Keep the in-memory count if session storage is unavailable.
		}
		if (dismissals >= maxDismissals) return;

		showTimer = window.setTimeout(() => {
			if (lazyImage) lazyImage.src = lazyImage.dataset.src;
			modal.classList.remove('hidden');
			if (position === 'center') overlay.classList.remove('hidden');
		}, Number(showDelay) + dismissals * dismissalDelay);
	}

	function hide() {
		modal.classList.add('hidden');
		overlay.classList.add('hidden');
	}

	function dismiss() {
		if (modal.classList.contains('hidden')) return;

		hide();
		dismissals += 1;
		try {
			sessionStorage.setItem(storageKey, String(dismissals));
		} catch {
			// The modal can still be closed if session storage is unavailable.
		}
	}

	modal.querySelector('button[data-close]').addEventListener('click', dismiss);
	overlay.addEventListener('click', dismiss);

	window.addEventListener('pagehide', () => {
		window.clearTimeout(showTimer);
		hide();
	});
	window.addEventListener('pageshow', (event) => {
		if (event.persisted) scheduleShow();
	});

	scheduleShow();
</script>
