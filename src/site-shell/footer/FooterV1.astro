---
import settings from '@/data/site/settings.json';
const { site_name, legal_entity, brand, footer_info } = settings;
import { getMenu } from '@/const';
const url = 'https://t.me/alexsab_ru';
const legalLinks = getMenu('footer_legal');
---

<footer class="bg-black text-white py-8" x-data="footer">
	<div class="container">
		<div class="flex justify-center">
			<a
				href="#"
				class="disclamer_switch switch text-white underline transition hover:no-underline"
				@click.prevent="onClick"
				>Подробные условия акций</a
			>
		</div>
		<div
			class="disclaimer text-xs"
			x-show="showDisclaimer"
		>
			<noindex>
				<p class="my-10">
					<Fragment set:html={footer_info} />
				</p>
			</noindex>
		</div>
		<div class="relative flex flex-col sm:flex-row justify-between pt-10">
			<div class="mb-4">
				<p>© 2024 {legal_entity}</p>
				{legalLinks.length > 0 && (
					<div class="flex gap-x-4 gap-y-1 flex-wrap mt-3 text-sm opacity-80">
						{legalLinks.map(link => (
							<a href={link.url} class="underline transition hover:no-underline" target={link.target} rel={link.rel}>{link.name}</a>
						))}
					</div>
				)}
			</div>
			<p class="relative bottom-0 right-0 text-sm opacity-70">Разработка <a href={url} target="_blank" rel="nofollow noopener noreferrer">alexsab.ru</a></p>
		</div>
	</div>
</footer>
