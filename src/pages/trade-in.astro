---
import { isRouteDisabled, SITE_NOT_FOUND_PATH } from '@/js/utils/siteRoutes';
if (isRouteDisabled('/trade-in/')) {
	return Astro.rewrite(SITE_NOT_FOUND_PATH);
}
import PageLayout from '@/layouts/PageLayout.astro';
import settings from '@/data/site/settings.json';
const { legal_entity, legal_inn } = settings;
import salonsData from '@/data/site/salons.json';
import type { ISalon } from '@/types/ISalon';
const salons = salonsData.filter((salon: ISalon) => !salon?.type || salon?.type.includes('trade_in'));
const singleCalltouch = salons.length === 1 ? salons[0]?.scripts?.calltouch : null;
import scripts_json from '@/data/site/scripts.json';
// Глобальный фолбэк routeKey из scripts.json — как в app.js; сгенерированный
// scripts.json не обязан содержать routeKey, поэтому тип задаём явно.
const fallbackCalltouch = (scripts_json?.calltouch?.value ?? {}) as { routeKey?: string };
const LEGAL_SALONS_INFO = legal_entity && legal_inn ? 
[`${legal_entity}`] : 
salons
    .filter(salon => salon?.legal_entity && salon?.legal_entity !== '')
    .map(s => `${s?.legal_entity}`);
import TradeInCalc from '@/react/TradeInCalc';
---

<PageLayout
    h1="Онлайн-оценка вашего автомобиля"
    title={`Онлайн-оценка вашего автомобиля в ${LEGAL_SALONS_INFO.join(' и ')}`}
    breadcrumb={[{name:"Онлайн-оценка вашего автомобиля",href:""}]}
>
    <TradeInCalc
        client:only
        ct_routeKey={singleCalltouch?.routeKey || fallbackCalltouch.routeKey || ''}
        ct_mod_id={singleCalltouch?.mod_id || ''}
        ct_site_id={singleCalltouch?.site_id || ''}
    />
</PageLayout>
