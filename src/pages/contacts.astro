---
import Layout from '@/layouts/Layout.astro';
import DealerMap from '@/blocks/map/Map.astro';
import DealerDirectory from '@/blocks/contacts/DealerDirectory.astro';
import MapWidget from '@/blocks/map/MapWidget.astro';
import AutoShowModal from '@/site-shell/auto-show-modal/AutoShowModal.astro';
import SocialList from '@/site-shell/social/SocialList.astro';
import InfoItem from '@/blocks/contacts/ContactsInfoItem.astro';
import WorkerItem from '@/blocks/contacts/ContactsWorkerItem.astro';
import settings from '@/data/site/settings.json';
import PageH1 from '@/ui/page-h1/PageH1.astro';
const { site_name, legal_entity, legal_inn, yandex_widget_orgnization, map_background, manager_photo } = settings;
import salonsData from '@/data/site/salons.json';
import type { ISalon } from '@/types/ISalon';
import { groupSalonsByCity } from '@/js/utils/salonCities';
import { getFeatureFlag } from '@/js/utils/features';
const showDirectory = getFeatureFlag(settings, 'contacts_directory', false) === true;
const salons: ISalon[] = salonsData.filter((salon: ISalon) => !salon?.type || salon?.type.includes('contact_page'));
const { cities, groups } = groupSalonsByCity(salons);
const hasMultipleCities = cities.length > 1;
const heading = hasMultipleCities ? `Контакты ${site_name}` : ['Контакты', ...cities].join(' ');
const SalonHeading = hasMultipleCities ? 'h3' : 'h2';
const useMapWidget = !hasMultipleCities && yandex_widget_orgnization;
const staff = salons.flatMap(salon =>
    salon?.staff?.map(worker => ({
        ...worker,
        salonName: salon.name
    })) || []
);
const description = `Контакты автосалона ${site_name} - ${salons
    .filter(salon => salon?.address && salon?.address !== '')
    .map(s => `${s?.address}`).join(', ')}`;
---

<Layout title={`Контакты автосалона ${site_name}`} description={`${description}`} breadcrumb={[{ name: 'Контакты', href: '/contacts/' }]}>
	<div class="container pt-10">
		<PageH1 h1={heading} classes="text-3xl sm:text-4xl" useSeo={!hasMultipleCities} />
	</div>
	{showDirectory ? (
		<DealerDirectory salons={salons} mapImage={map_background} legalEntity={legal_entity} legalInn={legal_inn} />
	) : <div class="divide-y divide-gray-200">
		{groups.map(([city, groupSalons], index) => {
			const headingId = hasMultipleCities ? `contacts-city-${index + 1}` : undefined;
			const mapSalons = groupSalons.filter(salon => salon.map?.coordinates);
			const hasMap = useMapWidget || mapSalons.length > 0;
			return (
				<section class="relative py-0!" aria-labelledby={headingId}>
					<div class:list={['container', hasMap && 'pb-[400px] md:pb-0']}>
						<div class:list={['py-8', hasMap && 'md:w-2/5']}>
							{headingId && <h2 id={headingId} class="mb-4 py-0! text-2xl sm:text-3xl before:hidden">{city ? `Контакты ${city}` : 'Остальные контакты'}</h2>}
							{index === 0 && legal_entity && (
								<div class="grid gap-5">
									<InfoItem class="flex items-center gap-2.5" label="Юридическое лицо" value={legal_entity} iconName="mdi:bank" />
									{legal_inn && <InfoItem class="flex items-center gap-2.5" label="ИНН" value={legal_inn} iconName="mdi:list-box-outline" />}
								</div>
							)}
							<div class:list={[
								'divide-y',
								groupSalons.length > 1 && 'max-h-80 md:max-h-[528px] overflow-y-auto custom-scrollbar',
							]}>
								{groupSalons.map(salon => (
									<div class="w-full flex flex-wrap gap-y-3 py-8">
										{salons.length > 1 && salon.name && <SalonHeading class="w-full text-base font-semibold mb-0 before:hidden">{salon.name}</SalonHeading>}
										{!legal_entity && salon.legal_entity && <InfoItem class="w-full flex items-center gap-2.5" label="Юридическое лицо" value={salon.legal_entity} iconName="mdi:bank" />}
										{!legal_entity && salon.legal_inn && <InfoItem class="w-full flex items-center gap-2.5" label="ИНН" value={salon.legal_inn} iconName="mdi:list-box-outline" />}
										{salon.address && <InfoItem class="w-full flex items-center gap-2.5" label="Адрес" value={salon.address} iconName="mdi:map-marker-outline" />}
										{salon.phone && <InfoItem class="w-full flex items-center gap-2.5" label="Телефон" value={salon.phone} iconName="mdi:cellphone" type="phone" />}
										{salon.schedule && <InfoItem class="w-full flex items-center gap-2.5" label="Режим работы" value={salon.schedule} iconName="mdi:clock-time-three-outline" />}
										{salon.socials && Object.keys(salon.socials).length > 0 && <SocialList data={salon.socials} class="w-full px-2" />}
									</div>
								))}
							</div>
						</div>
					</div>
					{hasMap && (
						<div class="absolute right-0 bottom-0 h-[400px] w-full md:top-0 md:h-auto md:w-1/2">
						{useMapWidget ? <MapWidget class="h-full" /> : <DealerMap mapImg={map_background} salons={mapSalons} classes="h-full" clusterMarkers />}
						</div>
					)}
				</section>
			);
		})}
	</div>}
	{staff.length > 0 && (
		<section class="bg-gray-100">
			<div class="container">
				<h2 class="mb-10">Ваши менеджеры</h2>
				<div class="flex gap-5 sm:gap-[1%] flex-wrap justify-center">
					{staff.map(worker => (
						<WorkerItem worker={worker} />
					))}
				</div>
			</div>
		</section>
	)}
</Layout>

<!--
	modalShow - Количество миллисекунд до показа окна (по умолчанию 20000)
	title - Заголовок
	modalPosition - позиция окна left-top|right-top|right-bottom|left-bottom|center (по умолчанию center)
	desktopBottomRight - правый нижний угол без затемнения на десктопе
	img - фото человека (по умолчанию пусто)
	imgPosition - позиция фото right|left (по умолчанию right)
-->

<AutoShowModal
	modalShow={30_000}
	title="Здравствуйте, оставьте телефон, я&nbsp;перезвоню и&nbsp;расскажу о&nbsp;преимуществах работы"
	modalPosition="center"
	desktopBottomRight
	img={manager_photo}
	imgPosition="right"
	formName="Форма со страницы - Контакты"
/>
