---
// Реестр блоков page-builder: type (из page.blocks JSON или из роута) -> компонент.
// Каждый case адаптирует блок к пропсам компонента ЕДИНООБРАЗНО:
//   c = данные блока (JSON content + route props, props важнее);
//   context = данные страницы (model, cars, ...) для блоков, которым нужен runtime-контекст.
// Добавить блок = импорт + ветка в switch.
import type { TBlock } from './types';
import RichContentBlock from '@/blocks/rich-content/RichContentBlock.astro';
import Faq from '@/blocks/faq/Faq.astro';
import Model from '@/blocks/model/Model.astro';
import PageH1 from '@/ui/page-h1/PageH1.astro';
import SeoText from '@/blocks/seo-text/SeoText.astro';
import ModelComplectations from '@/blocks/model/ModelComplectations.astro';
import FeedbackForm from '@/blocks/forms/feedback-form/FeedbackForm.astro';
import CallbackForm from '@/blocks/forms/callback/CallbackForm.astro';
import CarsGrid from '@/blocks/cars-grid/CarsGrid.astro';
import Hero from '@/blocks/hero/Hero.astro';
import Characteristics from '@/blocks/characteristics/Characteristics.astro';
import ColorShowcase from '@/blocks/color-showcase/ColorShowcase.astro';
import ImageCarousel from '@/blocks/image-gallery/ImageCarousel.astro';
import ActionGroup from '@/blocks/action-group/ActionGroup.astro';
import ModelHero from '@/blocks/model/ModelHero.astro';
import ModelColors from '@/blocks/model/ModelColors.astro';
import ModelPhotos from '@/blocks/model/ModelPhotos.astro';
import ModelCharacteristics from '@/blocks/model/ModelCharacteristics.astro';
import ModelActions from '@/blocks/model/ModelActions.astro';
import DealerDirectory from '@/blocks/contacts/DealerDirectory.astro';

interface Props {
	blocks?: TBlock[];
	context?: Record<string, any>;
}
const { blocks = [], context = {} } = Astro.props;

// Данные блока: JSON content + route props (props важнее). any — блоки собираются динамически.
const data = (block: TBlock): any => ({
	...(block?.content ?? {}),
	...(block?.props ?? {}),
});
---

{blocks.map((block) => {
	const c = data(block);
	switch (block?.type) {
		case 'page-h1':
			return (
				<PageH1
					h1={c.h1 ?? c.title ?? ''}
					classes={c.classes ?? c.class ?? ''}
				/>
			);
		case 'model':
			return context.model ? (
				<Model
					model={context.model}
					status={context.status}
					breadcrumb={context.breadcrumb}
					parts={c.parts}
					partOrder={c.partOrder}
					eyebrow={c.eyebrow}
					actions={c.actions}
					actionPreset={c.actionPreset}
					excludeActions={c.excludeActions}
					testDriveEnabled={c.testDriveEnabled}
					creditEnabled={c.creditEnabled}
				/>
			) : null;
		case 'rich-content':
			return <RichContentBlock section={block} />;
		case 'hero':
			return (
				<Hero
					{...c}
					id={block.id ?? c.id}
				/>
			);
		case 'characteristics':
			return <Characteristics {...c} />;
		case 'color-showcase':
			return <ColorShowcase {...c} />;
		case 'image-carousel':
			return <ImageCarousel {...c} />;
		case 'action-group':
			return <ActionGroup {...c} />;
		case 'dealer-directory':
			return <DealerDirectory salons={[]} {...c} id={block.id ?? c.id} />;
		case 'model-hero':
			return context.model ? (
				<ModelHero
					{...c}
					model={context.model}
					status={context.status}
					breadcrumb={context.breadcrumb}
				/>
			) : null;
		case 'model-colors':
			return context.model ? <ModelColors model={context.model} /> : null;
		case 'model-media':
			return context.model ? (
				<ModelPhotos
					{...c}
					model={context.model}
				/>
			) : null;
		case 'model-characteristics':
			return context.model ? (
				<ModelCharacteristics model={context.model} />
			) : null;
		case 'model-actions':
			return context.model ? (
				<ModelActions
					{...c}
					model={context.model}
					status={context.status}
				/>
			) : null;
		case 'faq':
			return (
				<Faq
					items={c.items ?? []}
					title={c.title}
					id={block.id}
					class={`sm:py-20 py-10 font-light model-section odd:bg-gray-100 ${block.sectionClass ?? c.sectionClass ?? ''}`}
					withSchema={Boolean(c.withSchema ?? c.schema ?? false)}
				/>
			);
		case 'model-complectations':
			return context.model?.complectations?.length ? (
				<ModelComplectations
					model={context.model}
					brand={context.brandDisplayName}
					title={
						c.title ??
						`Подобрать комплектацию ${context.brandDisplayName ?? ''} ${context.modelTitle ?? ''}`
					}
				/>
			) : null;
		case 'seo-text':
			return (
				<SeoText
					mdx={c.mdx}
					text={c.text}
					noPadding={c.noPadding}
					sectionPaddingBlock={c.sectionPaddingBlock}
				/>
			);
		case 'feedback-form':
			return (
				<section>
					<div class="section-grid">
						<FeedbackForm
							title={c.title}
							subtitle={c.subtitle}
							imageUrl={
								c.imageUrl ?? context.feedbackImageUrl ?? ''
							}
							images={c.images}
							labelBtn={c.labelBtn}
							dataFormName={c.dataFormName}
							showModelSelect={c.showModelSelect}
						/>
					</div>
				</section>
			);
		case 'callback':
			return (
				<CallbackForm
					bgUrl={c.bgUrl}
					bgImage={c.bgImage}
					bgPosition={c.bgPosition}
					title={c.title}
					subtitle={c.subtitle}
					formName={c.formName}
					btn={c.btn}
					showComment={c.showComment}
					commentPlaceholder={c.commentPlaceholder}
				/>
			);
		case 'cars-grid':
			return context.cars?.length ? (
				<CarsGrid
					cars={context.cars}
					title={c.title ?? context.carsTitle}
				/>
			) : null;
		default:
			return null;
	}
})}
