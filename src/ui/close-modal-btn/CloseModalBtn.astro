---
const { color = 'black', variant = 'plain' } = Astro.props;
const isThick = variant === 'bold' || variant === 'outlined';
const crossPath = 'M0 9.5H20M9.5 0V20';
---

<button
	type="button"
	aria-label="Закрыть окно"
	class:list={[
		'w-10 h-10 flex items-center justify-center absolute cursor-pointer z-10 p-0 border-0',
		variant === 'solid'
			? 'right-2 top-2 rounded-full bg-white shadow-sm transition-colors hover:bg-gray-100 active:bg-gray-200'
			: 'right-0 top-0 bg-transparent',
		isThick && 'transition-transform hover:scale-105 active:scale-95',
		!isThick && variant !== 'solid' && 'opacity-60 transition-opacity hover:opacity-100',
	]}
	data-close
>
	<svg
		width="20"
		height="20"
		viewBox="0 0 20 20"
		fill="none"
		xmlns="http://www.w3.org/2000/svg"
		data-close
		aria-hidden="true"
		class:list={[`rotate-45 custom-stroke-${color}`, isThick && 'overflow-visible']}
	>
		{variant === 'outlined' && (
			<path d={crossPath} class="stroke-white" stroke-width="5" stroke-linecap="round" data-close />
		)}
		<path
			d={crossPath}
			stroke-width={isThick ? 2.5 : variant === 'solid' ? 2 : undefined}
			stroke-linecap={isThick ? 'round' : undefined}
			data-close
		/>
	</svg>
</button>
