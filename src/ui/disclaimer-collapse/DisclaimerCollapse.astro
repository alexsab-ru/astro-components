---
import CollapsibleText from '@/ui/collapsible-text/CollapsibleText.astro';

interface Props {
    content: string | HTMLElement
}
const {content} = Astro.props;
---
<CollapsibleText variant="disclaimer" class="pt-5 mt-8 border-white/20 border-t">
    <Fragment set:html={content} />
</CollapsibleText>
