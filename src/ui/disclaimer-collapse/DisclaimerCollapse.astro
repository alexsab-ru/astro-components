---
import CollapsibleText from '@/ui/collapsible-text/CollapsibleText.astro';

interface Props {
    content: string | HTMLElement
}
const {content} = Astro.props;
---
<CollapsibleText
	mode="lines"
	collapsedLines={3}
	expandLabel="Показать все +"
	collapseLabel="Скрыть -"
	class="pt-5 mt-8 border-white/20 border-t"
	contentClass="text-xs! text-white/60 mb-2 space-y-4"
	buttonClass="text-xs"
	scroll="toggle"
	scrollTarget="root"
	scrollOffsetSelector="#site_nav"
>
    <Fragment set:html={content} />
</CollapsibleText>
