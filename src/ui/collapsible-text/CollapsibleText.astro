---
import { randomUUID } from 'node:crypto';

interface Props {
	variant?: 'seo' | 'rich' | 'disclaimer';
	expandLabel?: string;
	collapseLabel?: string;
	class?: string;
	contentClass?: string;
	buttonClass?: string;
}

const {
	variant = 'seo',
	expandLabel = { seo: 'читать полностью', rich: 'Подробнее', disclaimer: 'Показать все +' }[variant],
	collapseLabel = { seo: 'скрыть', rich: 'Свернуть', disclaimer: 'Скрыть -' }[variant],
	class: className,
	contentClass,
	buttonClass,
} = Astro.props;
const contentId = `collapse-${randomUUID()}`;
---

<collapsible-text
	class={className}
	data-variant={variant}
	data-expand-label={expandLabel}
	data-collapse-label={collapseLabel}
>
	<div
		id={contentId}
		class:list={[
			{ 'seo-content': variant === 'seo', 'space-y-4 my-8': variant === 'rich', 'text-xs! text-white/60 mb-2 space-y-4': variant === 'disclaimer' },
			contentClass,
		]}
		data-collapse-content
	>
		<slot />
	</div>
	<div class:list={{ 'flex justify-center mt-6': variant === 'seo' }}>
		<button
			type="button"
			class:list={[
				'collapse-toggle',
				{ 'seo-show-more no-underline!': variant === 'seo', 'underline cursor-pointer': variant === 'rich', 'text-xs': variant === 'disclaimer' },
				buttonClass,
			]}
			aria-expanded="true"
			aria-controls={contentId}
			data-collapse-toggle
			hidden
		>
			<span data-collapse-label>{collapseLabel}</span>
			{variant === 'seo' && <span class="seo-show-more-arrow" aria-hidden="true">&#187;</span>}
		</button>
	</div>
</collapsible-text>

<script>
	import './collapsible-text.js';
</script>

<style>
	collapsible-text { display: block; }
	[data-collapse-toggle][hidden] { display: none !important; }
	.collapse-toggle { cursor: pointer; }
	collapsible-text[data-expanded] > [data-collapse-content] {
		overflow: hidden;
		position: relative;
	}
	collapsible-text[data-variant='seo'][data-expanded='false'] > [data-collapse-content] { height: 230px; }
	collapsible-text[data-variant='rich'][data-expanded='false'] > [data-collapse-content] { height: 90px; }
	@media (min-width: 64rem) {
		collapsible-text[data-variant='rich'][data-expanded='false'] > [data-collapse-content] { height: 55px; }
	}
	collapsible-text[data-variant='disclaimer'][data-expanded='false'] > [data-collapse-content] {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
	}
	collapsible-text:is([data-variant='seo'], [data-variant='rich'])[data-expanded] > [data-collapse-content]::before {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		width: 100%;
		height: 100px;
		z-index: 10;
		pointer-events: none;
		background: linear-gradient(to top, var(--collapse-fade-color, #fff), transparent);
		opacity: 0;
	}
	collapsible-text[data-variant='seo'][data-expanded] > [data-collapse-content]::before { transition: opacity .25s; }
	collapsible-text[data-expanded='false'] > [data-collapse-content]::before { opacity: 1; }
	@media (prefers-reduced-motion: reduce) {
		collapsible-text[data-expanded] > [data-collapse-content]::before { transition: none; }
	}
</style>
