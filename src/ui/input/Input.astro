---
import type { HTMLAttributes } from 'astro/types';
import type { FieldProps } from '../form-field/types';
import FormField from '../form-field/FormField.astro';
import { FIELD_CONTROL_CLASSES, fieldAccessibility } from '../form-field/field.js';

interface Props extends Omit<HTMLAttributes<'input'>, 'type'>, FieldProps {
	type?: string;
	listOptions?: { id: string | number; name: string }[];
}
const {
	type = 'text', name, classes = '', wrapperClass, label, hint, id,
	class: nativeClass, title: nativeTitle,
	'aria-describedby': describedBy,
	placeholder = 'Введите значение', required = false, autocomplete = 'on',
	errorText = '', errorClasses = 'xs:text-[10px] text-xs text-red-500',
	list = '', listOptions = [], ...rest
} = Astro.props;
const field = fieldAccessibility({ id, label, hint, required, describedBy });
---

<FormField
	controlId={field.id}
	name={name}
	label={label}
	hint={hint}
	required={required}
	errorText={errorText}
	errorClasses={`mt-2 ${errorClasses}`}
	class={wrapperClass}
>
	<input
		type={type}
		name={name}
		id={field.id}
		aria-describedby={field.describedBy}
		aria-errormessage={field.errorMessage}
		class={nativeClass === undefined ? `${FIELD_CONTROL_CLASSES} outline-hidden ${classes}` : nativeClass}
		placeholder={placeholder}
		required={required}
		autocomplete={autocomplete}
		title={nativeTitle === undefined ? errorText || undefined : nativeTitle}
		{...rest}
		list={list}
	/>
	{list.length > 0 && (
		<datalist slot="after" id={list}>
			{listOptions.map(option => <option value={option.name} />)}
		</datalist>
	)}
</FormField>
