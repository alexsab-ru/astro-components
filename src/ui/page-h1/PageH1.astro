---
import seo from '@/data/site/seo.json';
interface Props {
	h1?: string;
	classes?: string;
	useSeo?: boolean;
}
let { h1 = '', classes = '', useSeo = true } = Astro.props;
const currentPath = Astro.url.pathname;
if (useSeo && seo[currentPath]) {
	const pageSeo = seo[currentPath];

	if (pageSeo.h1 && pageSeo.h1.trim()) {
		h1 = pageSeo.h1;
	}
}
---

{h1.length ? (<h1 class={classes} set:html={h1}></h1>) : null}
